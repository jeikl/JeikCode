<idea-plugin>
  <id>com.jeikcode.jetbrains</id>
  <name>JeikCode</name>
  <vendor email="support@jeikcode.com">JeikCode</vendor>

  <description><![CDATA[
    JeikCode brings a local AI coding agent into JetBrains IDEs.

    Use JeikCode from a dedicated tool window, editor context actions, and intentions to explain, fix, optimize, and review code while keeping the IDE workflow native. The plugin connects to a local JeikCode daemon on 127.0.0.1 by default and supports user-configured providers such as OpenAI, Claude, and Ollama through that daemon.

    Code, selected text, attached files, project metadata, provider settings, and API keys are sent only when needed to fulfill user actions and are handled by the local JeikCode daemon. See the privacy policy for details before configuring external model providers.
  ]]></description>

  <change-notes><![CDATA[
    Initial JetBrains Marketplace release.
    <ul>
      <li>Added the JeikCode tool window for local AI coding workflows.</li>
      <li>Added editor actions and intentions for explaining, fixing, optimizing, and attaching code context.</li>
      <li>Added local daemon discovery, startup, health checks, and bundled daemon support.</li>
      <li>Added session history, provider setup, model selection, diagnostics, and privacy-oriented context controls.</li>
    </ul>
  ]]></change-notes>

  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="jeikcode-jcef.xml">com.intellij.modules.jcef</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow
      id="JeikCode"
      anchor="right"
      canCloseContents="true"
      factoryClass="com.jeikcode.jetbrains.ui.JeikCodeToolWindowFactory"
      icon="/icons/jeikcode.svg" />

    <applicationConfigurable
      id="jeikcode.settings"
      displayName="JeikCode"
      instance="com.jeikcode.jetbrains.settings.JeikCodeConfigurable" />

    <statusBarWidgetFactory
      id="JeikCodeStatus"
      implementation="com.jeikcode.jetbrains.ui.JeikCodeStatusBarWidgetFactory" />

    <intentionAction>
      <className>com.jeikcode.jetbrains.actions.ExplainSelectionIntention</className>
      <category>JeikCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.jeikcode.jetbrains.actions.FixSelectionIntention</className>
      <category>JeikCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.jeikcode.jetbrains.actions.OptimizeSelectionIntention</className>
      <category>JeikCode</category>
    </intentionAction>
    <intentionAction>
      <className>com.jeikcode.jetbrains.actions.AddContextIntention</className>
      <category>JeikCode</category>
    </intentionAction>

    <projectService serviceImplementation="com.jeikcode.jetbrains.services.JeikCodeProjectService" />
    <projectService serviceImplementation="com.jeikcode.jetbrains.session.SessionWorkspace" />
    <projectService serviceImplementation="com.jeikcode.jetbrains.persistence.JeikCodeProjectWorkspaceState" />
    <applicationService serviceImplementation="com.jeikcode.jetbrains.settings.JeikCodeSettingsState" />
    <applicationService serviceImplementation="com.jeikcode.jetbrains.services.JeikCodeDaemonSupervisor" />
    <applicationService serviceImplementation="com.jeikcode.jetbrains.services.JeikCodeLoginCoordinator" />
    <postStartupActivity implementation="com.jeikcode.jetbrains.services.JeikCodeStartupActivity" />
  </extensions>

  <actions>
    <action
      id="jeikcode.openChat"
      class="com.jeikcode.jetbrains.actions.OpenChatAction"
      text="JeikCode: Open Chat"
      description="Open the JeikCode chat tool window">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.openWelcome"
      class="com.jeikcode.jetbrains.actions.OpenWelcomeAction"
      text="JeikCode: Welcome"
      description="Open the JeikCode welcome and quick start page">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.openChatInNewTab"
      class="com.jeikcode.jetbrains.actions.OpenChatInNewTabAction"
      text="JeikCode: Open Chat in New Tab"
      description="Open an independent JeikCode chat tab in the tool window">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.focusInput"
      class="com.jeikcode.jetbrains.actions.FocusInputAction"
      text="JeikCode: Focus Input"
      description="Open JeikCode and focus the chat input">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift I" />
    </action>

    <action
      id="jeikcode.newConversation"
      class="com.jeikcode.jetbrains.actions.NewConversationAction"
      text="JeikCode: New Conversation"
      description="Start a new JeikCode conversation">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift N" />
    </action>

    <action
      id="jeikcode.stopGeneration"
      class="com.jeikcode.jetbrains.actions.StopGenerationAction"
      text="JeikCode: Stop Generation"
      description="Stop the current JeikCode generation">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.openChanges"
      class="com.jeikcode.jetbrains.actions.OpenChangesAction"
      text="JeikCode: Open Changes"
      description="Open project changes used by JeikCode">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.openSettings"
      class="com.jeikcode.jetbrains.actions.OpenSettingsAction"
      text="JeikCode: Open Settings"
      description="Open JeikCode plugin settings">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.explainSelection"
      class="com.jeikcode.jetbrains.actions.ExplainSelectionAction"
      text="JeikCode: Explain Selection"
      description="Explain the selected code with JeikCode">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control alt shift E" />
    </action>

    <action
      id="jeikcode.fixSelection"
      class="com.jeikcode.jetbrains.actions.FixSelectionAction"
      text="JeikCode: Fix Selection"
      description="Fix the selected code with JeikCode">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.optimizeSelection"
      class="com.jeikcode.jetbrains.actions.OptimizeSelectionAction"
      text="JeikCode: Optimize Selection"
      description="Optimize the selected code with JeikCode">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>

    <action
      id="jeikcode.addContext"
      class="com.jeikcode.jetbrains.actions.AddContextAction"
      text="JeikCode: Add Selection/File as Context"
      description="Attach the current selection or file to the next JeikCode message">
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
