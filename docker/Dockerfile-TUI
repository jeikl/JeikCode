# JeikCode TUI Docker 镜像
# 用于在 macOS/Windows 上体验 Linux 版本的 JeikCode
#
# 构建步骤:
#   1. 准备 Linux x64 二进制（Release 资产或本地 musl 交叉编译）
#   2. docker build --build-arg JEIKCODE_BIN=<path> -t jeikcode -f docker/Dockerfile-TUI .
#
# 运行方式:
#   docker run --rm -it \
#     -v ~/.jeikcode:/root/.jeikcode \
#     -v $(pwd):/workspace \
#     jeikcode

FROM debian:bookworm-slim

# 使用国内镜像加速
RUN sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

# 安装必要的工具和库
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

# 复制预编译的 Linux 二进制（通过 --build-arg 指定）
ARG JEIKCODE_BIN
COPY ${JEIKCODE_BIN} /tmp/jeikcode

RUN chmod +x /tmp/jeikcode && \
    mv /tmp/jeikcode /usr/local/bin/jeikcode

# 设置工作目录
WORKDIR /workspace

# 设置终端环境变量
ENV TERM=xterm-256color
ENV COLORTERM=truecolor

# 入口点
ENTRYPOINT ["jeikcode"]
