{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JeikCode Desktop",
  "version": "7.1.7",
  "identifier": "com.jeikcode.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "JeikCode Desktop",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/cli-bin": "cli-bin"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
